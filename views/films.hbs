<link rel="stylesheet" href="/stylesheets/style.css">

<h1>Films</h1>

<div class="films-table-container">
  <table>
    <thead>
      <tr>
        <th>Film ID</th>
        <th>Title</th>
        <th>Year</th>
        <th>Genre</th>
        <th>Language</th>
        <th>Rental price</th>
        <th>Inventory stock</th>
        <th>Short description</th>
      </tr>
    </thead>
    <tbody>
      {{#each films}}
        <tr>
          <td>{{this.film_id}}</td>
          <td>{{this.title}}</td>
          <td>{{this.release_year}}</td>
          <td>{{this.categories}}</td>
          <td>{{this.language}}</td>
          <td>€{{this.price}}</td>
          <td>{{this.inventory_stock}}</td>
          <td>{{this.short_description}}</td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>